{
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "java.compile.nullAnalysis.mode": "automatic",
  "typescript.tsdk": [
    "./core/core-frontend/node_modules/typescript/lib"
  ],
  "javascript.implicitProjectConfig.check": false,
  "typescript.exclude": [
    "**/node_modules",
    "**/dist",
    "**/lib"
  ],
  "typescript.disabledSchemas": [],
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  }
}